# Used when the client is hosted on Apache-style shared hosting (SiteGround, for marz.gg).
# The page itself must never be cached, by the host's server cache or by browsers: a cached page
# from an older deploy points at script files that no longer exist, and the game won't load.
# Files in assets/ have a content hash in their name and never change, so they cache for a year.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, private"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#/$#">
    Header set Cache-Control "no-cache, private"
  </If>
  <If "%{REQUEST_URI} =~ m#/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
